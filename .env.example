# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env — ele está no .gitignore

# Supabase — obtenha em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://SEU-PROJECT-ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
